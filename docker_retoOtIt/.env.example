# Copia este archivo como .env en el servidor (/opt/docker_retoOtIt/.env)
# y escribe contrasenas reales. El archivo .env NUNCA se sube a GitHub.
# Reglas: solo letras, numeros y guion bajo; minimo 12 caracteres; las tres distintas.
DB_ADMIN_PASSWORD=cambia_esta_contrasena
DB_INGEST_PASSWORD=cambia_esta_contrasena
DB_READER_PASSWORD=cambia_esta_contrasena
DB_PANEL_PASSWORD=cambia_esta_contrasena
API_INGEST_TOKEN=pon_aqui_64_caracteres_hexadecimales
URL_PUBLICA=https://tu-servidor
CORREO_REMITENTE=panel@tu-dominio.com

# DB_INGEST_PASSWORD es la contrasena del rol app_insert y DB_READER_PASSWORD la de
# app_lectura, los dos de la base "historian" (ver db/historian.sql).
# Si el historian esta en el PostgreSQL del host (fuera de Docker), descomenta:
# HISTORIAN_HOST=host.docker.internal
# HISTORIAN_PORT=5432
